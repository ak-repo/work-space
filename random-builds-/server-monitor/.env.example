# HTTP server
APP_ADDR=:8085

# Optional PostgreSQL connection. Leave blank to run without DB monitoring.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable

# DB pool tuning
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_PING_TIMEOUT=2s

# How frequently server metrics are refreshed in the background.
SYSTEM_METRIC_INTERVAL=2s
